# Backend Configuration Example

# Server Environment
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://*.netlify.app

# Database URL
# For PostgreSQL / Supabase: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]
# If empty or omitted, defaults to local SQLite database (sqlite:///./chatbot.db)
DATABASE_URL=sqlite:///./chatbot.db

# AI Service Configuration
# Get your free API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
